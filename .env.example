# Copia este archivo a .env y ajusta los valores. Todas las variables llevan prefijo VA_.

# ── Vinted ────────────────────────────────────────────────────────────────────
VA_VINTED_DOMAIN=www.vinted.es
VA_ACCEPT_LANGUAGE=es-ES,es;q=0.9

# ── Transporte HTTP ───────────────────────────────────────────────────────────
# curl_cffi (recomendado: huella TLS/HTTP2 de navegador real) | httpx (alternativa)
VA_HTTP_TRANSPORT=curl_cffi
VA_HTTP_TIMEOUT_S=20
# Proxy propio opcional (una única IP tuya; no se hace rotación de pools).
# VA_HTTP_PROXY_URL=http://usuario:clave@host:puerto

# ── Ritmo de peticiones (presupuesto "humano") ────────────────────────────────
VA_RATE_LIMIT_PER_MINUTE=6
VA_RATE_LIMIT_BURST=2
# Jitter extra por petición como fracción del intervalo medio (0.35 = hasta +35 %)
VA_RATE_LIMIT_JITTER=0.35

# ── Reintentos (backoff exponencial con equal jitter) ─────────────────────────
VA_RETRY_MAX_ATTEMPTS=4
VA_RETRY_BASE_DELAY_S=3
VA_RETRY_MAX_DELAY_S=90

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Fallos blandos consecutivos (429/5xx/red) antes de abrir. 403/captcha abre al instante.
VA_BREAKER_FAILURE_THRESHOLD=3
VA_BREAKER_COOLDOWN_S=900
VA_BREAKER_MAX_COOLDOWN_S=21600

# ── Sesión ────────────────────────────────────────────────────────────────────
VA_SESSION_MAX_AGE_S=2400

# ── Planificación ─────────────────────────────────────────────────────────────
# Variación aleatoria del intervalo de cada búsqueda (0.2 = ±20 %)
VA_POLL_INTERVAL_JITTER=0.2

# ── Persistencia ──────────────────────────────────────────────────────────────
VA_DB_PATH=data/vinted_arb.sqlite3
VA_SEARCHES_FILE=config/searches.yaml

# ── Umbrales de oportunidad (Módulo 3) ────────────────────────────────────────
VA_MIN_NET_PROFIT_EUR=30
VA_MIN_ROI=0.20

# ── Alertas (Módulo 4) ────────────────────────────────────────────────────────
VA_TELEGRAM_BOT_TOKEN=
VA_TELEGRAM_CHAT_ID=
VA_DISCORD_WEBHOOK_URL=

# ── Referencias de mercado (Módulo 3) ─────────────────────────────────────────
VA_EBAY_CLIENT_ID=
VA_EBAY_CLIENT_SECRET=
VA_EBAY_MARKETPLACE_ID=EBAY_ES

# ── Logging ───────────────────────────────────────────────────────────────────
VA_LOG_LEVEL=INFO
