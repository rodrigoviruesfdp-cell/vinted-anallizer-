# Copia este archivo a .env y ajusta los valores. Todas las variables llevan prefijo VA_.

# ── Vinted ────────────────────────────────────────────────────────────────────
VA_VINTED_DOMAIN=www.vinted.es
VA_ACCEPT_LANGUAGE=es-ES,es;q=0.9

# ── Transporte HTTP ───────────────────────────────────────────────────────────
# curl_cffi (recomendado: huella TLS/HTTP2 de navegador real) | httpx (alternativa)
VA_HTTP_TRANSPORT=curl_cffi
VA_HTTP_TIMEOUT_S=20
# Proxy propio opcional (una única IP tuya; no se hace rotación de pools).
# VA_HTTP_PROXY_URL=http://usuario:clave@host:puerto

# ── Ritmo de peticiones (presupuesto "humano") ────────────────────────────────
VA_RATE_LIMIT_PER_MINUTE=6
VA_RATE_LIMIT_BURST=2
# Jitter extra por petición como fracción del intervalo medio (0.35 = hasta +35 %)
VA_RATE_LIMIT_JITTER=0.35

# ── Reintentos (backoff exponencial con equal jitter) ─────────────────────────
VA_RETRY_MAX_ATTEMPTS=4
VA_RETRY_BASE_DELAY_S=3
VA_RETRY_MAX_DELAY_S=90

# ── Circuit breaker ───────────────────────────────────────────────────────────
# Fallos blandos consecutivos (429/5xx/red) antes de abrir. 403/captcha abre al instante.
VA_BREAKER_FAILURE_THRESHOLD=3
VA_BREAKER_COOLDOWN_S=900
VA_BREAKER_MAX_COOLDOWN_S=21600

# ── Sesión ────────────────────────────────────────────────────────────────────
VA_SESSION_MAX_AGE_S=2400

# ── Planificación ─────────────────────────────────────────────────────────────
# Variación aleatoria del intervalo de cada búsqueda (0.2 = ±20 %)
VA_POLL_INTERVAL_JITTER=0.2

# ── Persistencia ──────────────────────────────────────────────────────────────
VA_DB_PATH=data/vinted_arb.sqlite3
VA_SEARCHES_FILE=config/searches.yaml

# ── Reventa y costes (Módulo 3) ───────────────────────────────────────────────
# Canal de reventa: vinted (por defecto) | wallapop | ebay_es_private | local_cash
VA_RESALE_CHANNEL=vinted
# Envío Vinted → tú (lo pagas como comprador). Ajústalo a tu tamaño de paquete habitual.
VA_INBOUND_SHIPPING_EUR=4.50
# Envío tú → comprador. En Vinted/Wallapop lo paga el comprador (no es coste tuyo).
VA_OUTBOUND_SHIPPING_EUR=6.00
VA_PACKAGING_EUR=1.50
# "Bump" de Vinted u otra promoción que pagues para vender antes (0 si no destacas)
VA_PROMOTION_EUR=0
# Pérdida esperada por fraude/defectos/devoluciones (fracción del precio de compra)
VA_RISK_RESERVE_RATE=0.03
# true si operas como profesional en REBU (IVA sobre el margen)
VA_REBU_ENABLED=false

# ── Valoración: mercado de Vinted (Módulo 3) ──────────────────────────────────
# Percentil de los anuncios comparables que se toma como precio de venta rápida
VA_FMV_PERCENTILE=0.30
# κ: fracción de ese precio que esperas cobrar tras aceptar ofertas a la baja
VA_FMV_ASK_TO_SALE=0.92
VA_FMV_WINDOW_DAYS=30
VA_FMV_HALF_LIFE_DAYS=14
# Muestras efectivas para confianza 1.0 en la referencia de mercado
VA_FMV_MIN_SAMPLES=12
# Precios manuales de arranque (sku,condition,price_eur,updated_at,notes)
VA_PRICE_BOOK_FILE=config/price_book.csv

# ── Umbrales de oportunidad (Módulo 3) ────────────────────────────────────────
VA_MIN_NET_PROFIT_EUR=30
VA_MIN_ROI=0.20
VA_MIN_MATCH_CONFIDENCE=0.80
VA_MIN_FMV_CONFIDENCE=0.60
VA_MAX_RISK=0.50

# ── Alertas (Módulo 4) ────────────────────────────────────────────────────────
VA_ALERT_MAX_PER_HOUR=30
VA_TELEGRAM_BOT_TOKEN=
VA_TELEGRAM_CHAT_ID=
VA_DISCORD_WEBHOOK_URL=

# ── Referencias de mercado (Módulo 3) ─────────────────────────────────────────
VA_EBAY_CLIENT_ID=
VA_EBAY_CLIENT_SECRET=
VA_EBAY_MARKETPLACE_ID=EBAY_ES

# ── Logging ───────────────────────────────────────────────────────────────────
VA_LOG_LEVEL=INFO
